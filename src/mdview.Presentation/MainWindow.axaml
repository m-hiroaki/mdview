<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mdview.Presentation.ViewModels"
        xmlns:views="using:mdview.Presentation.Views"
        x:Class="mdview.Presentation.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="mdview">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                MinHeight="38"
                Padding="8,0"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentTabViewModel">
                        <Border Padding="12,8" Margin="2,2,0,0" CornerRadius="6,6,0,0">
                            <TextBlock Text="{Binding Title}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ActiveDocument.Blocks}" Margin="18,12,18,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:MarkdownBlockView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
